#!/usr/bin/env bash
# Prepares an Amp orb to build, test and lint kimera: the Ruby that
# .ruby-version pins, Java for TLC, the root bundle, the Rails example's
# bundle and tla2tools.jar. Amp snapshots the result, so new orbs start with
# all of it in place (https://ampcode.com/docs/orbs/customizing).
#
# Safe to run again: each step checks what is already there first.
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

ruby_version="$(tr -d '[:space:]' < .ruby-version)"
case "$(uname -m)" in
  x86_64) arch=x64 ;;
  aarch64 | arm64) arch=arm64 ;;
  *) echo "setup: ruby/ruby-builder has no Linux build for $(uname -m)" >&2 && exit 1 ;;
esac
# The path ruby/setup-ruby installs to in CI. The build has it compiled in, so
# it cannot live anywhere else.
toolcache="/opt/hostedtoolcache/Ruby/$ruby_version"
ruby_bin="$toolcache/$arch/bin"

step() {
  local name="$1" started=$SECONDS
  shift
  echo "==> $name"
  "$@"
  echo "==> $name: done in $((SECONDS - started))s"
}

# The build ruby/setup-ruby downloads in CI. Orbs run Debian 12 or 13, and the
# Ubuntu 22.04 build (glibc 2.35) runs on both. It unpacks beside its final
# place and moves in whole, so an interrupted download leaves no half a Ruby.
install_ruby() {
  [[ -x "$ruby_bin/ruby" ]] && return 0
  local url="https://github.com/ruby/ruby-builder/releases/download/ruby-$ruby_version/ruby-$ruby_version-ubuntu-22.04-$arch.tar.gz"
  sudo mkdir -p "$toolcache"
  sudo chown "$(id -u):$(id -g)" "$toolcache"
  rm -rf "$toolcache/unpack"
  mkdir "$toolcache/unpack"
  curl -fsSL --retry 3 "$url" | tar -xz -C "$toolcache/unpack"
  mv "$toolcache/unpack/$arch" "$toolcache/$arch"
  rmdir "$toolcache/unpack"
}

# A snapshot keeps the directories ~/.bash_profile adds to PATH and nothing
# else of that file, which is all Ruby needs: gems install inside $toolcache.
persist_path() {
  local line="export PATH=\"$ruby_bin:\$PATH\""
  grep -Fqx "$line" "$HOME/.bash_profile" 2> /dev/null || echo "$line" >> "$HOME/.bash_profile"
}

# TLC needs Java 11 or later: bin/model-check, and the worker pool's trace
# validation in spec/property, which is skipped without it.
install_java() {
  command -v java > /dev/null && return 0
  sudo apt-get update -qq
  sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -qq --no-install-recommends default-jre-headless > /dev/null
}

# Gemfile.lock is not committed, so the first install resolves the newest gems
# the Gemfile allows, as CI does; later runs keep the lock they find.
install_bundle() {
  (cd "$1" && { bundle check > /dev/null 2>&1 || bundle install --jobs "$(nproc)"; })
}

versions() {
  ruby --version
  bundle --version
  java -version 2>&1 | head -n 1
}

# apt and the Ruby steps share nothing, so Java installs alongside them.
step "Java (default-jre-headless)" install_java &
java_install=$!

step "Ruby $ruby_version" install_ruby
export PATH="$ruby_bin:$PATH"
persist_path

step "Bundle" install_bundle .
step "Bundle for examples/rails_app" install_bundle examples/rails_app
step "tmp/tla2tools.jar" ruby bin/model-check --fetch

wait "$java_install"
step "Versions" versions
