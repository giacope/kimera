    {
      "kind": "change_coupling",
      "digest": "cli/run/arguments.rb <-> scope/config.rb",
      "reason": "a run's settings come from .kimera.yml (scope/config.rb, SCALAR_KEYS) merged under its flags (cli/run/arguments.rb), so each new setting touched both; the history stays until one table declares each setting for both"
    },
    {
      "kind": "change_coupling",
      "digest": "cli/run/flags.rb <-> scope/config.rb",
      "reason": "the same history: a setting's flag is declared in cli/run/flags.rb and its .kimera.yml key in scope/config.rb"
    },
    {
      "kind": "change_coupling",
      "digest": "report/text.rb <-> results/run_report.rb",
      "reason": "history of reworks that crossed the report layer (513bc3d, bab342f, 0d589a5): a field the run report gains is printed by the text report"
    },
    {
      "kind": "change_coupling",
