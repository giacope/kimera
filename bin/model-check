#!/usr/bin/env ruby
# frozen_string_literal: true

require "digest"
require "fileutils"
require "open-uri"
require "tmpdir"

module Kimera; end

class Kimera::ModelCheck
  USAGE = <<~TEXT
    Model-checks formal/WorkerPool.tla with TLC (needs Java 11+).

      bin/model-check                the checks CI runs (about a minute)
      bin/model-check --deep         larger instances (several minutes)
      bin/model-check N J            N mutants on J jobs: invariants and Termination
      bin/model-check --safety N J   invariants only, one state per symmetry orbit
  TEXT
  ROOT = File.expand_path("..", __dir__)
  JAR = File.join(ROOT, "tmp", "tla2tools.jar")
  JAR_URL = "https://github.com/tlaplus/tlaplus/releases/download/v1.8.0/tla2tools.jar"
  JAR_SHA256 = "ab4694601923fd5ac06452abbf847c366a5054a3d739552085edd6ed986c29ec"
  SPEC = File.join(ROOT, "formal", "WorkerPool.tla")
  CONFIG = File.join(ROOT, "formal", "WorkerPool.cfg")
  CI_CHECKS = [[2, 2, :all], [3, 1, :all], [1, 3, :all], [3, 2, :all], [5, 2, :safety], [4, 3, :safety]].freeze
  DEEP_CHECKS = [[4, 2, :all], [6, 2, :safety], [5, 3, :safety]].freeze

  def run(argv)
    return puts(USAGE) || true if argv.include?("--help")
    fetch
    checks(argv).all? { |mutants, jobs, scope| check(mutants, jobs, scope) }
  end

  private

  def checks(argv)
    return CI_CHECKS if argv.empty?
    return DEEP_CHECKS if argv == ["--deep"]
    scope = argv.delete("--safety") ? :safety : :all
    [[*argv.map { |arg| Integer(arg) }, scope]]
  end

  def fetch
    return if File.exist?(JAR) && Digest::SHA256.file(JAR).hexdigest == JAR_SHA256
    FileUtils.mkdir_p(File.dirname(JAR))
    body = URI.parse(JAR_URL).open("rb", &:read)
    abort("tla2tools.jar checksum mismatch") unless Digest::SHA256.hexdigest(body) == JAR_SHA256
    File.binwrite(JAR, body)
  end

  def check(mutants, jobs, scope)
    puts("== N=#{mutants} Jobs=#{jobs}#{" (invariants, symmetry)" if scope == :safety}")
    Dir.mktmpdir("tlc") { |dir| explore(dir, configured(dir, sized(mutants, jobs, scope))) }
  end

  def configured(dir, text)
    File.join(dir, "WorkerPool.cfg").tap { |config| File.write(config, text) }
  end

  def explore(dir, config)
    system(
      "java", "-XX:+UseParallelGC", "-cp", JAR, "tlc2.TLC", "-workers", "auto", "-cleanup",
      "-metadir", File.join(dir, "states"), "-config", config, SPEC, chdir: File.dirname(SPEC)
    )
  end

  def sized(mutants, jobs, scope)
    text = File.read(CONFIG)
      .sub(/^  Ids = .*$/, "  Ids = #{values("i", mutants)}")
      .sub(/^  Slots = .*$/, "  Slots = #{values("s", jobs)}")
    scope == :safety ? symmetric(text) : text
  end

  def symmetric(text) = text.sub(/^PROPERTIES\n(  .*\n)+/, "SYMMETRY Symmetry\n")

  def values(prefix, count) = "{#{(1..count).map { |n| "#{prefix}#{n}" }.join(", ")}}"
end

exit(Kimera::ModelCheck.new.run(ARGV))
