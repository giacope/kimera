#!/usr/bin/env ruby
# frozen_string_literal: true

require "English"
require "digest"
require "fileutils"
require "open-uri"
require "tmpdir"

module Kimera; end

class Kimera::ModelCheck
  USAGE = <<~TEXT
    Model-checks formal/WorkerPool.tla with TLC (needs Java 11+).

      bin/model-check                the checks CI runs (about 2 minutes), and one
                                     that must fail: the parent before #2, which
                                     read lines with a blocking pipe.gets
      bin/model-check --deep         larger instances (several minutes)
      bin/model-check N J            N mutants on J jobs: invariants and Termination
      bin/model-check --safety N J   invariants only, one state per symmetry orbit
      bin/model-check --fetch        download tla2tools.jar only (trace validation
                                     in spec/property/worker_pool_spec.rb runs it)
  TEXT
  ROOT = File.expand_path("..", __dir__)
  JAR = File.join(ROOT, "tmp", "tla2tools.jar")
  JAR_URL = "https://github.com/tlaplus/tlaplus/releases/download/v1.7.4/tla2tools.jar"
  JAR_SHA256 = "936a262061c914694dfd669a543be24573c45d5aa0ff20a8b96b23d01e050e88"
  SPEC = File.join(ROOT, "formal", "WorkerPool.tla")
  CONFIG = File.join(ROOT, "formal", "WorkerPool.cfg")
  CI_CHECKS = [
    [2, 2, :all], [3, 1, :all], [1, 3, :all], [3, 2, :all], [5, 2, :safety], [4, 3, :safety], [1, 1, :blocking]
  ].freeze
  DEEP_CHECKS = [[4, 2, :all], [6, 2, :safety], [5, 3, :safety]].freeze
  TITLES = {
    all: "", safety: " (invariants, symmetry)",
    blocking: " (blocking pipe.gets, as before #2: Termination must be violated)"
  }.freeze
  LIVENESS_VIOLATED = 13

  def run(argv)
    return puts(USAGE) || true if argv.include?("--help")
    fetch
    return true if argv == ["--fetch"]
    checks(argv).all? { |mutants, jobs, scope| check(mutants, jobs, scope) }
  end

  private

  def checks(argv)
    return CI_CHECKS if argv.empty?
    return DEEP_CHECKS if argv == ["--deep"]
    scope = argv.delete("--safety") ? :safety : :all
    [[*argv.map { |arg| Integer(arg) }, scope]]
  end

  def fetch
    return if File.exist?(JAR) && Digest::SHA256.file(JAR).hexdigest == JAR_SHA256
    FileUtils.mkdir_p(File.dirname(JAR))
    File.binwrite(JAR, verified(URI.parse(JAR_URL).open("rb", &:read)))
  end

  def verified(body)
    digest = Digest::SHA256.hexdigest(body)
    return body if digest == JAR_SHA256
    abort("tla2tools.jar checksum mismatch: #{JAR_URL} has sha256 #{digest}, pinned #{JAR_SHA256}")
  end

  def check(mutants, jobs, scope)
    puts("== N=#{mutants} Jobs=#{jobs}#{TITLES.fetch(scope)}")
    Dir.mktmpdir("tlc") { |dir| explore(dir, configured(dir, sized(mutants, jobs, scope))) }
    verdict(scope, $CHILD_STATUS.exitstatus)
  end

  def verdict(scope, status)
    return status.zero? unless scope == :blocking
    (status == LIVENESS_VIOLATED).tap { |caught| puts(caught ? "== caught, as it must be" : "== NOT caught") }
  end

  def configured(dir, text)
    File.join(dir, "WorkerPool.cfg").tap { |config| File.write(config, text) }
  end

  def explore(dir, config)
    FileUtils.cp(SPEC, dir)
    system(
      "java", "-XX:+UseParallelGC", "-cp", JAR, "tlc2.TLC", "-workers", "auto", "-cleanup",
      "-metadir", File.join(dir, "states"), "-config", File.basename(config), File.basename(SPEC), chdir: dir
    )
  end

  def sized(mutants, jobs, scope)
    text = File.read(CONFIG)
      .sub(/^  Ids = .*$/, "  Ids = #{values("i", mutants)}")
      .sub(/^  Slots = .*$/, "  Slots = #{values("s", jobs)}")
    return symmetric(text) if scope == :safety
    scope == :blocking ? text.sub("Blocking = FALSE", "Blocking = TRUE") : text
  end

  def symmetric(text) = text.sub(/^PROPERTIES\n(  .*\n)+/, "SYMMETRY Symmetry\n")

  def values(prefix, count) = "{#{(1..count).map { |n| "#{prefix}#{n}" }.join(", ")}}"
end

exit(Kimera::ModelCheck.new.run(ARGV))
